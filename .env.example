# Oracle database for Flyway migrations, risk settings, and paper trades
DB_URL=jdbc:oracle:thin:@//localhost:1521/XEPDB1
DB_USERNAME=GROWW_TRADER
DB_PASSWORD=replace-with-your-database-password

# Groww API credentials: use the API secret, not your Groww account login password
GROWW_API_ENABLED=true
GROWW_API_BASE_URL=https://api.groww.in
GROWW_API_KEY=
GROWW_API_SECRET=
# Alternatively, use an access token (expires daily; set only if you manage rotation)
GROWW_ACCESS_TOKEN=
GROWW_POLL_INTERVAL=1000

# Local Trading AI API; keep the service bound to loopback
TRADING_AI_ENABLED=true
TRADING_AI_ANALYSIS_URL=http://127.0.0.1:8000
TRADING_AI_TIMEOUT=20s

# Safety remains paper-only
TRADING_MODE=PAPER
LIVE_TRADING_ENABLED=false
